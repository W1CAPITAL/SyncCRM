
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user profile information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["admin", "lawyer", "assistant"] }
      }
    },
    "ProcessRecord": {
      "title": "Process Record",
      "description": "A single process record mirrored from the spreadsheet.",
      "type": "object",
      "properties": {
        "spreadsheetId": { "type": "string" },
        "sheetName": { "type": "string" },
        "rowIndex": { "type": "number" },
        "data": { "type": "object" },
        "status": { "type": "string" },
        "lawyer": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "SheetMirror": {
      "title": "Sheet Mirror",
      "description": "Metadata about the connected Google Spreadsheet.",
      "type": "object",
      "properties": {
        "spreadsheetId": { "type": "string" },
        "title": { "type": "string" },
        "lastSynced": { "type": "string", "format": "date-time" },
        "tabs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "History of changes and actions performed in the CRM.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "string" },
        "userId": { "type": "string" },
        "processId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile data."
    },
    "/users/{userId}/mirrors/{mirrorId}": {
      "schema": "SheetMirror",
      "description": "Stores synced sheet metadata."
    },
    "/users/{userId}/processes": {
      "schema": "ProcessRecord",
      "description": "Stores actual process data for fast querying and filtering."
    },
    "/users/{userId}/audit": {
      "schema": "AuditLog",
      "description": "Stores user-specific audit history."
    }
  }
}
